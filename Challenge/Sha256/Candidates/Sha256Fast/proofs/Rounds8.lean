/-- The rounds-loop control tail: advance the group pointer by 256 and branch
back to the loop head while it is below 2048 (the "continue" case). -/
theorem ctrl_continue (s : State) (S0 S1 S2 S3 S4 S5 S6 S7 : UInt32)
    (q : UInt256) (rest : List UInt256)
    (hcap : rest.length < 1000) (hrun : s.halt = .Running)
    (haw : s.activeWords = UInt256.ofNat 140)
    (hbr : UInt256.isTrue
      (UInt256.lt (UInt256.ofNat 256 + q) (UInt256.ofNat 2048)))
    (hcode : s.executionEnv.code = bytes)
    (hpc : s.pc = UInt256.ofNat 1680)
    (hstack : s.stack = [ofUInt32 S0, ofUInt32 S1, ofUInt32 S2, ofUInt32 S3, ofUInt32 S4, ofUInt32 S5, ofUInt32 S6, ofUInt32 S7] ++ q :: rest) :
    runLocatedBlock pctrl s =
      some { s with
        pc := UInt256.ofNat 911
        stack := [ofUInt32 S0, ofUInt32 S1, ofUInt32 S2, ofUInt32 S3, ofUInt32 S4, ofUInt32 S5, ofUInt32 S6, ofUInt32 S7] ++ (UInt256.ofNat 256 + q) :: rest } := by
  have hdest : Decode.isValidJumpDest bytes 911 = true := by
    have h := ProgramArtifact.isValidJumpDest_index art 534 (by rfl)
    have hpc534 : art.instructionPC 534 = 911 := by rfl
    rw [hpc534] at h
    exact h
  evm_block hcap


/-! Round-output definitions.  `d{j}`/`h{j}` are round `j`'s two fresh
working variables (in FIPS terms the new `e` = d + T1 and the new
`a` = T1 + T2), as functions of the original eight inputs and the K/W
values consumed so far.  Keeping every stack entry an *application* of
these defs holds all iteration statements at constant size; each step
lemma's unification unfolds exactly one definition level. -/
def d0 (S0 S1 S2 S3 S4 S5 S6 S7 Kc0 Wt0 : UInt32) : UInt32 :=
  S3 + T1 S4 S5 S6 S7 Kc0 Wt0
def h0 (S0 S1 S2 S3 S4 S5 S6 S7 Kc0 Wt0 : UInt32) : UInt32 :=
  T1 S4 S5 S6 S7 Kc0 Wt0 + T2 S0 S1 S2
def d1 (S0 S1 S2 S3 S4 S5 S6 S7 Kc0 Wt0 Kc1 Wt1 : UInt32) : UInt32 :=
  S2 + T1 (d0 S0 S1 S2 S3 S4 S5 S6 S7 Kc0 Wt0) S4 S5 S6 Kc1 Wt1
def h1 (S0 S1 S2 S3 S4 S5 S6 S7 Kc0 Wt0 Kc1 Wt1 : UInt32) : UInt32 :=
  T1 (d0 S0 S1 S2 S3 S4 S5 S6 S7 Kc0 Wt0) S4 S5 S6 Kc1 Wt1 + T2 (h0 S0 S1 S2 S3 S4 S5 S6 S7 Kc0 Wt0) S0 S1
def d2 (S0 S1 S2 S3 S4 S5 S6 S7 Kc0 Wt0 Kc1 Wt1 Kc2 Wt2 : UInt32) : UInt32 :=
  S1 + T1 (d1 S0 S1 S2 S3 S4 S5 S6 S7 Kc0 Wt0 Kc1 Wt1) (d0 S0 S1 S2 S3 S4 S5 S6 S7 Kc0 Wt0) S4 S5 Kc2 Wt2
def h2 (S0 S1 S2 S3 S4 S5 S6 S7 Kc0 Wt0 Kc1 Wt1 Kc2 Wt2 : UInt32) : UInt32 :=
  T1 (d1 S0 S1 S2 S3 S4 S5 S6 S7 Kc0 Wt0 Kc1 Wt1) (d0 S0 S1 S2 S3 S4 S5 S6 S7 Kc0 Wt0) S4 S5 Kc2 Wt2 + T2 (h1 S0 S1 S2 S3 S4 S5 S6 S7 Kc0 Wt0 Kc1 Wt1) (h0 S0 S1 S2 S3 S4 S5 S6 S7 Kc0 Wt0) S0
def d3 (S0 S1 S2 S3 S4 S5 S6 S7 Kc0 Wt0 Kc1 Wt1 Kc2 Wt2 Kc3 Wt3 : UInt32) : UInt32 :=
  S0 + T1 (d2 S0 S1 S2 S3 S4 S5 S6 S7 Kc0 Wt0 Kc1 Wt1 Kc2 Wt2) (d1 S0 S1 S2 S3 S4 S5 S6 S7 Kc0 Wt0 Kc1 Wt1) (d0 S0 S1 S2 S3 S4 S5 S6 S7 Kc0 Wt0) S4 Kc3 Wt3
def h3 (S0 S1 S2 S3 S4 S5 S6 S7 Kc0 Wt0 Kc1 Wt1 Kc2 Wt2 Kc3 Wt3 : UInt32) : UInt32 :=
  T1 (d2 S0 S1 S2 S3 S4 S5 S6 S7 Kc0 Wt0 Kc1 Wt1 Kc2 Wt2) (d1 S0 S1 S2 S3 S4 S5 S6 S7 Kc0 Wt0 Kc1 Wt1) (d0 S0 S1 S2 S3 S4 S5 S6 S7 Kc0 Wt0) S4 Kc3 Wt3 + T2 (h2 S0 S1 S2 S3 S4 S5 S6 S7 Kc0 Wt0 Kc1 Wt1 Kc2 Wt2) (h1 S0 S1 S2 S3 S4 S5 S6 S7 Kc0 Wt0 Kc1 Wt1) (h0 S0 S1 S2 S3 S4 S5 S6 S7 Kc0 Wt0)
def d4 (S0 S1 S2 S3 S4 S5 S6 S7 Kc0 Wt0 Kc1 Wt1 Kc2 Wt2 Kc3 Wt3 Kc4 Wt4 : UInt32) : UInt32 :=
