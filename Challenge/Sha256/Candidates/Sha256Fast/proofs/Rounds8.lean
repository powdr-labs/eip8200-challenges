    (hrun : s.halt = .Running) (hpc : s.pc = UInt256.ofNat 1296)
    (hstack : s.stack =
      [ofUInt32 S0, ofUInt32 S1, ofUInt32 S2, ofUInt32 S3, ofUInt32 S4, ofUInt32 S5, ofUInt32 S6, ofUInt32 S7] ++ q :: rest)
    (hk : MachineState.readWord s.memory
      (UInt256.ofNat 2560 + q).toNat = ofUInt32 Kc)
    (hw : MachineState.readWord s.memory
      (UInt256.ofNat 512 + q).toNat = dbl (ofUInt32 Wt)) :
    runLocatedBlock pround4 s =
      some { s with
        pc := UInt256.ofNat 1392
        activeWords := UInt256.ofNat 140
        stack := [ofUInt32 S0, ofUInt32 S1, ofUInt32 S2, ofUInt32 (T1 S0 S1 S2 S3 Kc Wt + T2 S4 S5 S6), ofUInt32 S4, ofUInt32 S5, ofUInt32 S6, ofUInt32 (S7 + T1 S0 S1 S2 S3 Kc Wt)] ++ q :: rest } := by
