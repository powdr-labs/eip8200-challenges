/-- Round 2 of the eight-round loop body (permutation `cdefghab`).
`q` is the group pointer; `K` and `W` are read at `q`-relative addresses. -/
theorem round2 (s : State) (S0 S1 S2 S3 S4 S5 S6 S7 Kc Wt : UInt32) (q : UInt256)
    (rest : List UInt256) (hcap : rest.length < 1000)
    (hq : q.toNat ≤ 1792) (haw : s.activeWords = UInt256.ofNat 140)
    (hbk : (UInt256.ofNat 2496 + q).toNat + 32 ≤ 4480)
    (hbw : (UInt256.ofNat 448 + q).toNat + 32 ≤ 4480)
    (hrun : s.halt = .Running) (hpc : s.pc = UInt256.ofNat 1104)
    (hstack : s.stack =
      [ofUInt32 S0, ofUInt32 S1, ofUInt32 S2, ofUInt32 S3, ofUInt32 S4, ofUInt32 S5, ofUInt32 S6, ofUInt32 S7] ++ q :: rest)
    (hk : MachineState.readWord s.memory
      (UInt256.ofNat 2496 + q).toNat = ofUInt32 Kc)
    (hw : MachineState.readWord s.memory
      (UInt256.ofNat 448 + q).toNat = dbl (ofUInt32 Wt)) :
    runLocatedBlock pround2 s =
      some { s with
        pc := UInt256.ofNat 1200
        activeWords := UInt256.ofNat 140
        stack := [ofUInt32 S0, ofUInt32 (S1 + T1 S2 S3 S4 S5 Kc Wt), ofUInt32 S2, ofUInt32 S3, ofUInt32 S4, ofUInt32 (T1 S2 S3 S4 S5 Kc Wt + T2 S6 S7 S0), ofUInt32 S6, ofUInt32 S7] ++ q :: rest } := by
  simp only [T1, T2]
  evm_block hcap
  and_intros <;>
    first | ac_rfl | (apply congrArg UInt256.ofNat; omega) | omega

