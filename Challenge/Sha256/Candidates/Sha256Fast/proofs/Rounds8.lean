theorem round4 (s : State) (S0 S1 S2 S3 S4 S5 S6 S7 Kc Wt : UInt32) (q : UInt256)
    (rest : List UInt256) (hcap : rest.length < 1000)
    (hq : q.toNat ≤ 1792) (haw : s.activeWords = UInt256.ofNat 140)
    (hbk : (UInt256.ofNat 2560 + q).toNat + 32 ≤ 4480)
