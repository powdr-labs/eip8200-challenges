set_option warningAsError true

/-!
# Compact EIP-2537 regression vectors

These constants are a deliberately small, self-contained slice of the
official execution-spec-tests.  They cover every operation and the subgroup
distinction between ADD versus MSM/pairing without copying the multi-megabyte
MSM JSON files into this repository.
-/

namespace Challenge.Bls12381.Vectors

open EvmSemantics

structure Vector where
  label : String
  input : ByteArray
  expected : ByteArray
  gas : Nat

def zeros (n : Nat) : ByteArray := Data.Bytes.natToBytesPadded 0 n

private def fp (n : Nat) : ByteArray := Data.Bytes.natToBytesPadded n 64
private def scalar (n : Nat) : ByteArray := Data.Bytes.natToBytesPadded n 32

private def pointG1 (x y : Nat) : ByteArray := fp x ++ fp y

private def pointG2 (x₀ x₁ y₀ y₁ : Nat) : ByteArray :=
  fp x₀ ++ fp x₁ ++ fp y₀ ++ fp y₁

