def mapFp2ToG2FirstPaddingInvalid : ByteArray :=
  Hex.hexToBytes "01" ++ zeros 127

/-- Exact-size input with a nonzero second-component padding byte. -/
def mapFp2ToG2SecondPaddingInvalid : ByteArray :=
  zeros 64 ++ Hex.hexToBytes "01" ++ zeros 63

/-- Symmetric noncanonical second Fp component (`c1 = p`) regression. -/
def mapFp2ToG2SecondComponentInvalid : ByteArray :=
  fp 0 ++ fp EvmSemantics.Crypto.Bls12381.p

def pairing : Vector :=
  { label := "official non-degeneracy e(g1, g2) != 1"
    input := generatorG1 ++ generatorG2
    expected := zeros 32
    gas := 70300 }

